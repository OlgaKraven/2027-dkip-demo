<Window x:Class="Dkip.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Width="540" Height="550" MinWidth="500" MinHeight="500"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Логин"/>
            <TextBox x:Name="LoginInput" AutomationProperties.Name="Логин" Margin="0,4,0,10"/>
            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Пароль" Margin="0,4,0,12"/>
            <TextBlock Text="Соберите изображение: выберите два фрагмента" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Grid Height="204">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image x:Name="Original" Width="200" Height="200" HorizontalAlignment="Left"/>
                <UniformGrid x:Name="Puzzle" Grid.Column="1" Rows="2" Columns="2" Width="204" Height="204"/>
            </Grid>
            <Button x:Name="SignInButton" Content="Войти" Click="SignIn" IsDefault="True" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
