<Window x:Class="Dkip.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ДЭ 2027 · Авторизация · WPF / PostgreSQL" Width="580" Height="680" MinWidth="550" MinHeight="640" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="16" Background="White">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="36"><TextBlock Text="Информационная система" FontSize="27" FontWeight="Bold" Margin="0,0,0,20"/><TextBlock Text="Логин"/><TextBox x:Name="LoginInput" AutomationProperties.Name="Логин"/><TextBlock Text="Пароль"/><PasswordBox x:Name="PasswordInput" Padding="8" AutomationProperties.Name="Пароль"/><TextBlock Text="Соберите изображение: выберите два фрагмента" Margin="0,18,0,12" TextWrapping="Wrap"/>
<Grid Height="210"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Image x:Name="Original" Width="200" Height="200" HorizontalAlignment="Left"/><UniformGrid x:Name="Puzzle" Grid.Column="1" Rows="2" Columns="2" Width="204" Height="204"/></Grid>
<Button x:Name="SignInButton" Content="Войти" Click="SignIn" Background="#DC1928" Foreground="White" Margin="0,22,0,0" IsDefault="True"/></StackPanel></ScrollViewer></Window>
