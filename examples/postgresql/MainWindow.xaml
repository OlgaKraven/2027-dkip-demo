<Window x:Class="Dkip.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ДЭ 2027 · WPF / PostgreSQL" Width="1180" Height="700" MinWidth="980" MinHeight="600" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="16"><TabControl Margin="16">
<TabItem Header="Заказ и себестоимость"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12"><Button Content="Рассчитать заказ № 1" Click="Calculate"/><TextBlock x:Name="Total" Margin="20,12"/></StackPanel><DataGrid x:Name="OrdersGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" ColumnWidth="*"/></DockPanel></TabItem>
<TabItem Header="Заказчики"><DataGrid x:Name="PartiesGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" ColumnWidth="*"/></TabItem>
<TabItem x:Name="UsersTab" Header="Пользователи"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="12"><WrapPanel><TextBlock Text="Логин" Margin="0,12,8,0"/><TextBox x:Name="UserLogin" Width="155" AutomationProperties.Name="Логин пользователя"/><TextBlock Text="Новый пароль" Margin="12,12,8,0"/><PasswordBox x:Name="NewPassword" Width="155" Padding="8" AutomationProperties.Name="Новый пароль"/><ComboBox x:Name="UserRole" Width="115" Margin="12,0" SelectedIndex="0"><ComboBoxItem Content="user"/><ComboBoxItem Content="admin"/></ComboBox><CheckBox x:Name="Unlock" Content="Снять блокировку" VerticalAlignment="Center"/></WrapPanel><WrapPanel><Button Content="Новый" Click="NewUser"/><Button Content="Сохранить" Click="SaveUser"/><TextBlock Text="Пустой пароль при изменении сохраняет прежний." Margin="12"/></WrapPanel></StackPanel><DataGrid x:Name="UsersGrid" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="True" ColumnWidth="*" SelectionMode="Single" SelectionChanged="SelectUser"/></DockPanel></TabItem>
</TabControl></Window>
