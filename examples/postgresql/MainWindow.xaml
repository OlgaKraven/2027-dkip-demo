<Window x:Class="Dkip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рабочее окно" Width="810" Height="470" MinWidth="780" MinHeight="450"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="16">
    <DockPanel Margin="20">
        <TextBlock x:Name="RoleLabel" Text="Рабочее окно" DockPanel.Dock="Top" Margin="0,0,0,14"/>
        <DockPanel x:Name="AdminPanel">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <WrapPanel>
                    <StackPanel Width="175" Margin="0,0,15,0">
                        <TextBlock Text="Логин"/>
                        <TextBox x:Name="UserLogin" AutomationProperties.Name="Логин пользователя"/>
                    </StackPanel>
                    <StackPanel Width="175" Margin="0,0,15,0">
                        <TextBlock Text="Новый пароль"/>
                        <PasswordBox x:Name="NewPassword" AutomationProperties.Name="Новый пароль"/>
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,15,0">
                        <TextBlock Text="Роль"/>
                        <ComboBox x:Name="UserRole" SelectedIndex="0" AutomationProperties.Name="Роль">
                            <ComboBoxItem Content="Пользователь"/>
                            <ComboBoxItem Content="Администратор"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="Unlock" Content="Снять блокировку" VerticalAlignment="Bottom"/>
                </WrapPanel>
                <WrapPanel Margin="0,12,0,8">
                    <Button x:Name="NewButton" Content="Новый" Width="120" Click="NewUser"/>
                    <Button x:Name="SaveButton" Content="Сохранить" Width="120" Margin="10,0,0,0" Click="SaveUser"/>
                </WrapPanel>
                <TextBlock Text="Выберите строку для изменения. Пустой новый пароль сохраняет прежний." TextWrapping="Wrap"/>
            </StackPanel>
            <DataGrid x:Name="UsersGrid" IsReadOnly="True" CanUserAddRows="False"
                      AutoGenerateColumns="True" ColumnWidth="*" SelectionMode="Single"
                      SelectionChanged="SelectUser"/>
        </DockPanel>
    </DockPanel>
</Window>
